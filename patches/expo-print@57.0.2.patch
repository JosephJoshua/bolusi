+
+  // `width` and `height` are points (1/72 inch). A size within a millimetre of a standard paper
+  // becomes that paper, since points are rounded and the dialog needs its exact size to select it.
+  private fun mediaSizeFromOptions(options: PrintOptions): PrintAttributes.MediaSize? {
+    val width = options.width ?: return null
+    val height = options.height ?: return null
+    if (width <= 0 || height <= 0) return null
+    val shortMils = (minOf(width, height) * MILS_PER_POINT).roundToInt()
+    val longMils = (maxOf(width, height) * MILS_PER_POINT).roundToInt()
+    return STANDARD_MEDIA_SIZES.firstOrNull {
+      abs(it.widthMils - shortMils) <= MILS_PER_MM && abs(it.heightMils - longMils) <= MILS_PER_MM
+    } ?: PrintAttributes.MediaSize("expo-print-$shortMils-$longMils", "${toMm(shortMils)} x ${toMm(longMils)} mm", shortMils, longMils)
+  }
+
+  private fun toMm(mils: Int): Int {
+    return (mils * 25.4 / 1000).roundToInt()
+  }

{
  "name": "@bolusi/test-support",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Golden vectors, determinism kit, fakes, driver-conformance suite \u2014 test-only, never imported by shipping source (08 \u00a73.2)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./chaos": {
      "types": "./dist/chaos/index.d.ts",
      "default": "./dist/chaos/index.js"
    },
    "./vectors/ed25519.json": "./vectors/ed25519.json",
    "./layout-audit": {
      "types": "./dist/layout-audit.d.ts",
      "default": "./dist/layout-audit.js"
    }
  },
  "files": [
    "dist",
    "vectors"
  ],
  "dependencies": {
    "@bolusi/core": "workspace:*",
    "@bolusi/schemas": "workspace:*",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@bolusi/db-client": "workspace:*",
    "@bolusi/tsconfig": "workspace:*",
    "@types/node": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}

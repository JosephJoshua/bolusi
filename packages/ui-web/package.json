{
  "name": "@bolusi/ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop and web design system: React DOM components on the shared tokens (Radix primitives, Tailwind)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@bolusi/ui": "workspace:*",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-toggle-group": "1.1.20",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.15",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@bolusi/tsconfig": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "jsdom": "30.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run"
  }
}

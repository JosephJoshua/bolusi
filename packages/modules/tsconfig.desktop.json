    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.desktop.tsbuildinfo"
  },
  "include": ["src/*/desktop"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "../ui-web/tsconfig.build.json"
    }
  ]
}

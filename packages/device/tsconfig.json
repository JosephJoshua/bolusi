{
  // Tests and helpers typecheck here; they touch Node (better-sqlite3, node:crypto). Shipping
  // source builds through tsconfig.build.json on the react-native base, where `node:*` cannot resolve.
  "extends": "@bolusi/tsconfig/react-native.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "test"]
}

{
  "name": "@bolusi/device",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What every enrolled device runs, shared by the phone and the counter PC: boot, command runtime, PIN session, sync, enrolment and the media queue. Platform bindings are injected.",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bolusi/core": "workspace:*",
    "@bolusi/db-client": "workspace:*",
    "@bolusi/i18n": "workspace:*",
    "@bolusi/modules": "workspace:*",
    "@bolusi/schemas": "workspace:*",
    "kysely": "catalog:"
  },
  "peerDependencies": {
    "@bolusi/ui": "workspace:*"
  },
  "devDependencies": {
    "@bolusi/sqlite-test-driver": "workspace:*",
    "@bolusi/test-support": "workspace:*",
    "@bolusi/tsconfig": "workspace:*",
    "@bolusi/ui": "workspace:*",
    "@types/node": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -b ../.. && vitest run"
  }
}

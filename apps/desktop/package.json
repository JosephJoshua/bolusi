{
  "name": "@bolusi/desktop",
  "productName": "Bolusi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Counter PC app (Windows): Electron shell with its own React DOM screens on the shared offline core",
  "author": "Bolusi",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p src/main && vite build -c vite.core.config.ts && vite build",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/main && tsc -p src/core && tsc -p e2e",
    "test": "vitest run",
    "e2e": "pnpm run build && playwright test -c e2e/playwright.config.ts",
    "dist": "pnpm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@bolusi/core": "workspace:*",
    "@bolusi/db-client": "workspace:*",
    "@bolusi/device": "workspace:*",
    "@bolusi/harness": "workspace:*",
    "@bolusi/i18n": "workspace:*",
    "@bolusi/modules": "workspace:*",
    "@bolusi/schemas": "workspace:*",
    "@bolusi/sqlite-test-driver": "workspace:*",
    "@bolusi/test-support": "workspace:*",
    "@bolusi/tsconfig": "workspace:*",
    "@bolusi/ui-web": "workspace:*",
    "@noble/hashes": "catalog:",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.18.0",
    "hash-wasm": "4.12.0",
    "jsdom": "30.1.2",
    "kysely": "catalog:",
    "lucide-react": "1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}

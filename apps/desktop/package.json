{
  "name": "@bolusi/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Counter PC app (Windows): Electron shell with its own React DOM screens on the shared offline core",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p src/main && vite build",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/main && tsc -p e2e",
    "test": "vitest run",
    "e2e": "pnpm run build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@bolusi/i18n": "workspace:*",
    "@bolusi/modules": "workspace:*",
    "@bolusi/ui-web": "workspace:*",
    "lucide-react": "1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@bolusi/tsconfig": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}

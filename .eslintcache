er in the native bundle. Its\n * strings — demo screen titles, seeded names, and harness chrome (\"harness: back\", the camera\n * placeholder) — must NOT go through @bolusi/i18n: the catalog is for shipping UI and is guarded by\n * the id/en parity gate (07-i18n §7.3), which pollution with dev copy would corrupt. The REAL screens\n * this harness renders resolve every user-visible label through the catalog, unchanged.",{"range":"5386","text":"5377"},{"range":"5387","text":"5379"},"the fake matches the mod's shape",{"range":"5388","text":"5377"},{"range":"5389","text":"5379"},{"range":"5390","text":"5377"},{"range":"5391","text":"5379"},"reuse the mutated manifest",{"range":"5392","text":"5377"},{"range":"5393","text":"5379"},{"range":"5394","text":"5377"},{"range":"5395","text":"5379"},{"range":"5396","text":"5377"},{"range":"5397","text":"5379"},{"range":"5398","text":"5377"},{"range":"5399","text":"5379"},[1435,1438],"unknown",[1435,1438],"never",[2232,2235],[2232,2235],[2530,2533],[2530,2533],[1735,1738],[1735,1738],[1817,1820],[1817,1820],[2703,2706],[2703,2706],[2861,2864],[2861,2864],[4720,4723],[4720,4723],[5120,5123],[5120,5123],[4320,4323],[4320,4323],[5988,5991],[5988,5991]]